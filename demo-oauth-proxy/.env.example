PORT=8787
NODE_ENV=production

# Shared secret the main Company Brain backend must send in the
# `x-proxy-secret` header when calling POST /exchange/:provider.
# Generate with: openssl rand -hex 32
PROXY_SHARED_SECRET=

# Comma-separated list of origins allowed to call this service.
# Usually just your hosted Company Brain backend's URL.
ALLOWED_ORIGINS=https://app.companybrain.example

# ─── Real credentials for the ONE shared Slack App used for instant demos ───
DEMO_SLACK_CLIENT_ID=
DEMO_SLACK_CLIENT_SECRET=

# ─── Real credentials for the ONE shared Google OAuth Client used for instant demos ───
DEMO_GOOGLE_CLIENT_ID=
DEMO_GOOGLE_CLIENT_SECRET=
