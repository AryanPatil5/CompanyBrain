{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "dev:api": "PROCESSES=api tsx watch src/bootstrap.ts",
    "dev:mcp": "PROCESSES=mcp tsx watch src/bootstrap.ts",
    "dev:crawler": "PROCESSES=crawler tsx watch src/bootstrap.ts",
    "dev:ingestion-worker": "PROCESSES=ingestion-worker tsx watch src/bootstrap.ts",
    "dev:github-sync-worker": "PROCESSES=github-sync-worker tsx watch src/bootstrap.ts",
    "dev:temporal-worker": "PROCESSES=temporal-worker tsx watch src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "test": "tsx test/run-all.ts",
    "test:e2e": "NODE_ENV=test tsx test/e2e/companyBrain.e2e.test.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrator.ts",
    "migrate:status": "tsx src/db/migrator.ts status",
    "migrate:rollback": "tsx src/db/migrator.ts rollback-last",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@e2b/code-interpreter": "^1.0.0",
    "@google/genai": "^2.15.0",
    "@openfga/sdk": "^0.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@supabase/supabase-js": "^2.45.0",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "bullmq": "^6.0.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "fastmcp": "^1.7.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^1.9.1",
    "isolated-vm": "^6.1.2",
    "jose": "^5.6.3",
    "pdf-parse": "^1.1.4",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^20.14.9",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.3",
    "eslint": "^9.39.5",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.66.0"
  }
}
