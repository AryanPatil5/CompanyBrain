PORT=5001
NODE_ENV=development
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://brain_user:brain_password@localhost:5432/company_brain
# Observability (Phase 0 Task 9): structured JSON logs always on; OTel only
# when explicitly enabled. Secrets are redacted from logs automatically.
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=company-brain-server
# Per-process health endpoints — each process serves GET /health on its own port
# (structured JSON: dependency status inside; HTTP always 200 while process alive)
CRAWLER_PORT=5002
MCP_HEALTH_PORT=5003
INGESTION_WORKER_HEALTH_PORT=5004
GITHUB_SYNC_WORKER_HEALTH_PORT=5005
TEMPORAL_WORKER_HEALTH_PORT=5006
# Cost meter (Phase 0 Task 10): report-only per-workspace quota in cents.
# Key = COST_QUOTA_<WORKSPACE_ID_UPPERCASE_WITH_NON_ALPHANUMERICS_AS_UNDERSCORES>.
# Unset = no quota (always allowed). checkQuota reports status, never enforces.
COST_QUOTA_00000000_0000_4000_8000_000000000001=0
GEMINI_API_KEY=your_free_google_ai_studio_key_here
ENABLE_OLLAMA=false
# Embedding provider (Phase 4 T1): select exactly ONE.
#   ollama — local, non-production default. EMBEDDING_MODEL must be a locally
#            pulled model that emits exactly 1536 dimensions. OLLAMA_HOST (or
#            OLLAMA_BASE_URL) also feeds the Ollama LLM adapter with
#            ENABLE_OLLAMA=true.
#   openai — hosted OpenAI-compatible embeddings endpoint, server-side key only.
EMBEDDING_PROVIDER=ollama
# Server-side API key for the hosted OpenAI-compatible provider
# (EMBEDDING_PROVIDER=openai). Never shipped to the client; redacted from logs.
OPENAI_API_KEY=your_server_side_openai_api_key_here
# Base URL override for OpenAI-compatible gateways (Azure OpenAI, proxies, ...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Model handled to the provider. Providers must emit exactly 1536 dimensions
# (Supabase pgvector vector(1536) column); anything else fails loudly as
# embedding_failed — deterministic pseudo-vectors are never generated.
EMBEDDING_MODEL=nomic-embed-text
# Version recorded on document_chunks from the provider-returned metadata.
EMBEDDING_VERSION=v1
OPENROUTER_MODEL=~deepseek/deepseek-v4-flash-latest
WORKER_CONCURRENCY=2

# ─── Feature-flag inventory (IMPLEMENTATION_ORDER.md §3 prereq #3) ───
# Phase 2 (connector framework): registry-dispatched `crawl_provider` jobs.
# Legacy crawler dispatch stays the default and is unchanged while OFF.
CRAWLER_V2=false

# ─── Object storage (ADR-T6 / Phase 3): S3-compatible storageProvider ───
# Local dev: MinIO from docker-compose (ports 9000/9001, dev credentials
# minioadmin/minioadmin). Production: any S3-compatible provider (AWS S3,
# GCS XML-API, Supabase Storage) behind the same interface. Bucket is
# PRIVATE; all access is server-side — no signed/public URLs in Phase 3.
# When STORAGE_ENDPOINT is unset, upload ingestion is unavailable (POST
# /api/documents returns 503) and /health reports storage: unavailable.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=company-brain
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
# Max upload size accepted by POST /api/documents (multipart).
STORAGE_MAX_UPLOAD_MB=25
# Explicit provider override. 'memory' is for hermetic tests/dev only and is
# REFUSED when NODE_ENV=production. Unset = s3 when STORAGE_ENDPOINT is set.
# STORAGE_PROVIDER=s3

# ─── Supabase Cloud / Local Connection ───
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key
VAULT_SECRET_KEY=your_32_byte_hex_vault_secret_key
# KEY_PROVIDER=environment   # explicit key provider; production refuses 'memory' (dev/test only) and unset values
KMS_MASTER_KEY=your_64_hex_char_32_byte_master_key_here_for_kms_encryption
OPENROUTER_API_KEY=your_openrouter_api_key

# ─── OAuth Connect Flow (Settings → Integrations in the UI) ───
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_client_secret
SLACK_SIGNING_SECRET=your_slack_app_signing_secret
GITHUB_APP_NAME=your_github_app_slug
GITHUB_WEBHOOK_SECRET=your_github_app_webhook_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
APP_BASE_URL=http://localhost:5001
CLIENT_BASE_URL=http://localhost:3000

# ─── GitHub Connector (GitHub App) ───
GITHUB_APP_ID=your_github_app_id
# Either inline PEM (with literal newlines) or a path to a PEM file:
GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...
GITHUB_APP_PRIVATE_KEY_PATH=/absolute/path/to/github-app.pem
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_SYNC_CONCURRENCY=4
GITHUB_SYNC_BATCH_SIZE=25
GITHUB_SYNC_FILE_SIZE_LIMIT_KB=1024
GITHUB_SYNC_MAX_FILES_PER_RUN=10000
GITHUB_SYNC_TIMEOUT_MS=30000

# ─── Postgres (migration runner + postgresAdapter) ───
# Local docker-compose default is used when unset:
#   postgresql://brain_user:brain_password@localhost:5432/company_brain
# On Supabase cloud, point this at the (pooled) DSN for `npm run migrate`.
DATABASE_URL=
# Future read-replica pooler endpoint (Phase 1 read model): informational only.
PG_REPLICA_URL=

# ─── CI / test environment (used by the hermetic runner, never in prod) ───
# The runner installs its own deterministic values; these are overrides for
# edge cases only.
CI=0
CI_TEST_LOG_LEVEL=warn